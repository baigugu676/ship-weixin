/* pages/chat/chat.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #041527;
}

/* 自定义导航栏 */
.nav-bar {
  background: rgba(4, 21, 39, 0.95);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  flex-shrink: 0;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
}

.nav-title-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #14b8a6;
  box-shadow: 0 0 6px rgba(20, 184, 166, 0.6);
}

.nav-title {
  font-size: 15px;
  font-weight: 600;
  color: #e2e8f0;
}

.nav-actions {
  display: flex;
  gap: 8px;
}

.nav-btn {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.nav-btn-icon {
  font-size: 18px;
  color: #94a3b8;
  font-weight: 300;
}

/* 欢迎界面 */
.welcome-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px;
  overflow-y: auto;
}

.welcome-logo {
  position: relative;
  margin-bottom: 24px;
}

.logo-glow {
  position: absolute;
  inset: -16px;
  background: rgba(45, 212, 191, 0.2);
  filter: blur(24px);
  border-radius: 50%;
  animation: glow-pulse 3s ease-in-out infinite;
}

.logo-box {
  position: relative;
  width: 64px;
  height: 64px;
  background: linear-gradient(135deg, rgba(45, 212, 191, 0.2), rgba(37, 99, 235, 0.2));
  border: 1px solid rgba(45, 212, 191, 0.4);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
}

@keyframes glow-pulse {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(1.1); }
}

.welcome-title {
  font-size: 20px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8px;
  text-align: center;
}

.welcome-desc {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
  line-height: 1.7;
  margin-bottom: 24px;
  max-width: 280px;
  white-space: pre-line;
}

.quick-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  width: 100%;
  max-width: 320px;
}

.quick-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 16px 12px;
  text-align: center;
  transition: all 0.3s;
}

.quick-card:active {
  background: rgba(56, 189, 248, 0.12);
  border-color: rgba(56, 189, 248, 0.3);
  transform: scale(0.98);
}

.quick-card-icon {
  font-size: 24px;
  display: block;
  margin-bottom: 8px;
}

.quick-card-title {
  display: block;
  font-size: 13px;
  font-weight: 500;
  color: #fff;
  margin-bottom: 4px;
}

.quick-card-desc {
  display: block;
  font-size: 10px;
  color: rgba(255, 255, 255, 0.4);
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 16px;
  box-sizing: border-box;
}

.message-wrap {
  margin-bottom: 16px;
}

.message-row {
  display: flex;
  gap: 10px;
}

.message-row.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
}

.avatar-user {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  font-weight: 600;
}

.avatar-ai {
  background: #0a2530;
  border: 1px solid rgba(20, 184, 166, 0.3);
}

.message-bubble-user {
  max-width: 75%;
  background: linear-gradient(135deg, #0d9488, #14b8a6);
  color: #fff;
  padding: 12px 16px;
  border-radius: 16px;
  border-bottom-right-radius: 4px;
  word-wrap: break-word;
}

.message-content-ai {
  max-width: 75%;
  flex: 1;
}

.message-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 3px 8px;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 500;
}

.tag-online {
  background: rgba(59, 130, 246, 0.15);
  color: #60a5fa;
  border: 1px solid rgba(59, 130, 246, 0.3);
}

.tag-offline {
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.tag-kg {
  background: rgba(20, 184, 166, 0.15);
  color: #2dd4bf;
  border: 1px solid rgba(20, 184, 166, 0.3);
}

/* 追踪面板 */
.trace-panel {
  background: rgba(59, 130, 246, 0.08);
  border: 1px solid rgba(59, 130, 246, 0.2);
  border-radius: 10px;
  margin-bottom: 8px;
  overflow: hidden;
}

.trace-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
}

.trace-title {
  font-size: 11px;
  color: #60a5fa;
}

.trace-arrow {
  font-size: 10px;
  color: #60a5fa;
  transition: transform 0.2s;
}

.trace-arrow.open {
  transform: rotate(180deg);
}

.trace-body {
  padding: 0 12px 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.trace-step {
  font-size: 10px;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.5;
}

/* AI 消息气泡 */
.message-bubble-ai {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 12px 16px;
  border-radius: 16px;
  border-bottom-left-radius: 4px;
  word-wrap: break-word;
}

.message-text {
  font-size: 14px;
  line-height: 1.7;
  color: #e2e8f0;
}

.message-rich-text {
  font-size: 14px;
  line-height: 1.7;
  color: #e2e8f0;
}

.typing-cursor {
  display: inline-block;
  margin-left: 4px;
}

.cursor {
  display: inline-block;
  width: 2px;
  height: 16px;
  background: #14b8a6;
  animation: blink 1s step-end infinite;
  vertical-align: middle;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* 流式控制 */
.stream-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.stream-btn {
  display: inline-flex;
  align-items: center;
  padding: 6px 12px;
  background: rgba(59, 130, 246, 0.1);
  border: 1px solid rgba(59, 130, 246, 0.25);
  border-radius: 8px;
  font-size: 12px;
  color: #60a5fa;
}

.stream-btn:active {
  background: rgba(59, 130, 246, 0.2);
}

.stream-pause-hint {
  font-size: 11px;
  color: #fbbf24;
}

/* 参考文献 */
.citations-panel, .kg-panel {
  margin-top: 8px;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 10px;
  overflow: hidden;
}

.citations-header, .kg-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
}

.citations-title, .kg-title {
  font-size: 11px;
  color: #94a3b8;
}

.citations-arrow, .kg-arrow {
  font-size: 10px;
  color: #94a3b8;
  transition: transform 0.2s;
}

.citations-arrow.open, .kg-arrow.open {
  transform: rotate(180deg);
}

.citations-body, .kg-body {
  padding: 0 12px 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.citation-item {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 8px;
  padding: 10px;
}

.citation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.citation-index {
  font-size: 10px;
  padding: 2px 6px;
  background: rgba(56, 189, 248, 0.1);
  border: 1px solid rgba(56, 189, 248, 0.2);
  border-radius: 4px;
  color: #7dd3fc;
}

.citation-score {
  font-size: 10px;
  color: #2dd4bf;
}

.citation-source {
  display: block;
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 4px;
}

.citation-text {
  display: block;
  font-size: 11px;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
}

.kg-triplet {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.6;
}

.message-bottom {
  height: 20px;
}

/* 底部输入区 */
.input-section {
  background: linear-gradient(to top, #041527 0%, #041527 80%, transparent 100%);
  padding: 8px 16px 16px;
  flex-shrink: 0;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
}

.upload-status {
  margin-bottom: 8px;
}

.upload-status-text {
  font-size: 11px;
  padding: 6px 10px;
  border-radius: 6px;
}

.upload-status-text.success {
  color: #34d399;
  background: rgba(16, 185, 129, 0.1);
}

.upload-status-text.error {
  color: #f87171;
  background: rgba(239, 68, 68, 0.1);
}

.upload-status-text.info {
  color: #60a5fa;
  background: rgba(59, 130, 246, 0.1);
}

.recent-uploads {
  margin-bottom: 8px;
  padding: 8px 10px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 8px;
}

.recent-uploads-title {
  font-size: 10px;
  color: #64748b;
  margin-bottom: 6px;
  display: block;
}

.upload-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4px 0;
}

.upload-item-name {
  font-size: 11px;
  color: #e2e8f0;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upload-item-badge {
  font-size: 9px;
  padding: 2px 6px;
  border-radius: 4px;
}

.upload-item-badge.success {
  color: #34d399;
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.2);
}

.upload-item-badge.error {
  color: #f87171;
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
}

.upload-item-badge.uploading {
  color: #60a5fa;
  background: rgba(59, 130, 246, 0.1);
  border: 1px solid rgba(59, 130, 246, 0.2);
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 6px 6px 6px 12px;
}

.attach-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.attach-icon {
  font-size: 18px;
  color: #94a3b8;
}

.upload-spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-top-color: #60a5fa;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.chat-input {
  flex: 1;
  height: 40px;
  color: #e2e8f0;
  font-size: 14px;
  background: transparent;
  border: none;
  outline: none;
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.25);
  font-size: 14px;
}

.send-btn {
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.send-btn.pause {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}

.send-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.send-icon {
  font-size: 14px;
  color: #fff;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(4px);
}

.modal-content {
  background: #0a2540;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 24px;
  width: 280px;
  text-align: center;
}

.modal-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8px;
}

.modal-desc {
  display: block;
  font-size: 13px;
  color: #94a3b8;
  margin-bottom: 20px;
}

.modal-actions {
  display: flex;
  gap: 12px;
}

.modal-btn {
  flex: 1;
  padding: 10px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.modal-btn.cancel {
  background: rgba(255, 255, 255, 0.05);
  color: #94a3b8;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #0d9488, #0a2540);
  color: #fff;
}
