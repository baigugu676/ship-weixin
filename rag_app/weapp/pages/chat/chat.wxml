<!--pages/chat/chat.wxml-->
<view class="chat-container {{appearance}}" style="font-size: {{fontSize}}px;">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-title-wrap">
        <view class="status-dot"></view>
        <text class="nav-title">{{currentChat ? currentChat.title : '智能船舶问答'}}</text>
      </view>
      <view class="nav-actions">
        <view class="nav-btn" bindtap="goToEquipment"><text>设备</text></view>
        <view class="nav-btn" wx:if="{{currentChatId}}" bindtap="exportCurrentChat"><text>导出</text></view>
        <view class="nav-btn" bindtap="showNewChatConfirm" wx:if="{{currentChatId}}">
          <text class="nav-btn-icon">+</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 欢迎界面 -->
  <view class="welcome-section" wx:if="{{!currentChatId}}">
    <view class="welcome-logo">
      <view class="logo-glow"></view>
      <view class="logo-box">⚓</view>
    </view>
    <text class="welcome-title">欢迎使用智能船舶问答系统</text>
    <text class="welcome-desc">基于知识图谱的深度故障诊断引擎已就绪
请告诉我您想了解的船舶设备问题</text>
    
    <view class="demo-card" wx:if="{{demoQuestions.length}}">
      <text class="demo-title">设备数据演示</text>
      <text class="demo-note">使用模拟记录，可查看参数、报警、故障和检修日期</text>
      <view class="demo-question" wx:for="{{demoQuestions}}" wx:key="*this" bindtap="onDemoQuestion" data-question="{{item}}">{{item}} ›</view>
    </view>
    <view class="quick-cards">
      <view class="quick-card" wx:for="{{quickCards}}" wx:key="title" bindtap="onQuickCardTap" data-title="{{item.title}}">
        <text class="quick-card-icon">{{item.icon}}</text>
        <text class="quick-card-title">{{item.title}}</text>
        <text class="quick-card-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 聊天消息区 -->
  <scroll-view 
    wx:if="{{currentChatId}}"
    class="message-list" 
    scroll-y 
    scroll-into-view="{{scrollToMessage}}"
    scroll-with-animation
    enhanced
    show-scrollbar
  >
    <view class="message-wrap" wx:for="{{currentChat.messages}}" wx:key="id" id="msg-{{item.id || index}}">
      <!-- 用户消息 -->
      <view class="message-row user" wx:if="{{item.role === 'user'}}">
        <view class="message-bubble-user">
          <image wx:if="{{item.image}}" class="user-msg-image" src="{{item.image}}" mode="aspectFill" />
          <text class="message-text">{{item.content}}</text>
        </view>
        <view class="avatar avatar-user">
          <text>{{userAvatarText}}</text>
        </view>
      </view>

      <!-- AI 消息 -->
      <view class="message-row ai" wx:if="{{item.role === 'ai'}}">
        <view class="avatar avatar-ai">
          <text>⚓</text>
        </view>
        <view class="message-content-ai">
          <!-- 状态标签 -->
          <view class="message-tags">
            <view class="tag tag-offline" wx:if="{{item.isOffline}}">
              <text>💾 离线回答</text>
            </view>
            <view class="tag tag-online" wx:if="{{!item.isOffline}}">
              <text>📶 在线回答</text>
            </view>
            <view class="tag tag-kg" wx:if="{{item.isGraphEnabled || item.kgTriplets.length > 0}}">
              <text>🔍 知识图谱</text>
            </view>
          </view>

          <!-- 追踪步骤 -->
          <view class="trace-panel" wx:if="{{item.traceSteps.length > 0}}">
            <view class="trace-header" bindtap="toggleTrace" data-msgid="{{item.id}}">
              <text class="trace-title">📊 后端响应过程</text>
              <text class="trace-arrow {{item.traceOpen ? 'open' : ''}}">▼</text>
            </view>
            <view class="trace-body" wx:if="{{item.traceOpen}}">
              <text class="trace-step" wx:for="{{item.traceSteps}}" wx:for-item="step" wx:key="index">{{index + 1}}. {{step.text}}</text>
            </view>
          </view>

          <!-- 消息内容：收尾后渲染富文本（去吃 ###、** 等 Markdown 标记）；流式中显示去标记的纯文本 -->
          <view class="message-bubble-ai">
            <rich-text wx:if="{{item.renderedContent}}" class="message-rich-text" nodes="{{item.renderedContent}}"></rich-text>
            <text class="message-text" wx:else>{{item.displayText || item.content}}</text>
            <view class="typing-cursor" wx:if="{{item.isStreaming && !item.isPaused}}">
              <view class="cursor"></view>
            </view>
          </view>

          <view class="trace-panel" wx:if="{{item.databaseResult}}">
            <view class="trace-header" bindtap="toggleSql" data-msgid="{{item.id}}">
              <text class="trace-title">设备数据库{{item.databaseResult.data_kind === 'demo' ? ' · 演示数据' : ''}}</text>
              <text>{{item.sqlOpen ? '收起' : '展开 SQL / 表格'}}</text>
            </view>
            <view class="trace-body" wx:if="{{item.sqlOpen}}">
              <text class="trace-step">查询时间：{{item.databaseResult.executed_at}}（上海时间） · {{item.databaseResult.row_count}} 条记录</text>
              <text class="trace-step" wx:if="{{item.databaseResult.period}}">统计区间：{{item.databaseResult.period.start}} 至 {{item.databaseResult.period.end_exclusive}}（不含结束时间）</text>
              <text class="sql-code" selectable>{{item.databaseResult.sql}}</text>
              <scroll-view scroll-x class="sql-table-scroll">
                <view class="sql-table">
                  <view class="sql-row sql-head"><text class="sql-cell" wx:for="{{item.databaseResult.columns}}" wx:key="*this">{{item}}</text></view>
                  <view class="sql-row" wx:for="{{item.databaseRows}}" wx:for-item="row" wx:key="index">
                    <text class="sql-cell" wx:for="{{row}}" wx:for-item="cell" wx:key="index" selectable>{{cell}}</text>
                  </view>
                </view>
              </scroll-view>
              <text class="trace-step" wx:if="{{!item.databaseResult.row_count}}">没有符合条件的记录</text>
              <text class="trace-step" wx:if="{{item.databaseResult.truncated}}">结果已截断，请缩小时间范围。</text>
              <view class="stream-btn" bindtap="exportSqlResult" data-msgid="{{item.id}}">导出结果 CSV</view>
            </view>
          </view>
          <view class="message-tools" wx:if="{{!item.isStreaming}}" bindtap="copyMessage" data-msgid="{{item.id}}">复制回答</view>

          <!-- 流式控制 -->
          <view class="stream-controls" wx:if="{{item.isStreaming && item.isPaused}}">
            <view class="stream-btn" bindtap="resumeStreaming" data-msgid="{{item.id}}">
              <text>▶ 继续回答</text>
            </view>
            <text class="stream-pause-hint">⏸️ 用户已暂停</text>
          </view>

          <!-- 参考文献 -->
          <view class="citations-panel" wx:if="{{item.citations.length > 0}}">
            <view class="citations-header" bindtap="toggleCitations" data-msgid="{{item.id}}">
              <text class="citations-title">📚 参考来源 ({{item.citations.length}})</text>
              <text class="citations-arrow {{item.citationsOpen ? 'open' : ''}}">▼</text>
            </view>
            <view class="citations-body" wx:if="{{item.citationsOpen}}">
              <view class="citation-item" wx:for="{{item.citations}}" wx:for-item="cit" wx:key="index">
                <view class="citation-header">
                  <text class="citation-index">资料{{index + 1}}</text>
                  <text class="citation-score" wx:if="{{cit.score}}">相关度 {{cit.score}}%</text>
                </view>
                <text class="citation-source">来源：{{cit.source}}</text>
                <text class="citation-text" wx:if="{{cit.text}}">{{cit.text}}</text>
              </view>
            </view>
          </view>

          <!-- 知识图谱三元组 -->
          <view class="kg-panel" wx:if="{{item.kgTriplets.length > 0}}">
            <view class="kg-header" bindtap="toggleKg" data-msgid="{{item.id}}">
              <text class="kg-title">🕸️ 知识图谱 ({{item.kgTriplets.length}})</text>
              <text class="kg-arrow {{item.kgOpen ? 'open' : ''}}">▼</text>
            </view>
            <view class="kg-body" wx:if="{{item.kgOpen}}">
              <text class="kg-triplet" wx:for="{{item.kgTriplets}}" wx:for-item="t" wx:key="index">{{index + 1}}. {{t.head}} --{{t.rel || t.relation || '关联'}}--> {{t.tail}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 底部占位 -->
    <view class="message-bottom" id="msg-bottom"></view>
  </scroll-view>

  <!-- 底部输入区 -->
  <view class="input-section">
    <view class="sync-hint" wx:if="{{syncError}}" bindtap="retrySync">{{syncError}}</view>
    <picker range="{{queryModes}}" value="{{queryModeIndex}}" bindchange="onQueryModeChange" disabled="{{isAnswering}}">
      <view class="mode-picker">查询模式：{{queryModes[queryModeIndex]}} ▾</view>
    </picker>
    <!-- 上传状态 -->
    <view class="upload-status" wx:if="{{uploadStatus}}">
      <text class="upload-status-text {{uploadStatus.type}}">{{uploadStatus.text}}</text>
    </view>

    <!-- 最近上传 -->
    <view class="recent-uploads" wx:if="{{recentUploads.length > 0}}">
      <text class="recent-uploads-title">最近上传</text>
      <view class="upload-item" wx:for="{{recentUploads}}" wx:key="id">
        <text class="upload-item-name">{{item.name}}</text>
        <view class="upload-item-badge {{item.status}}">
          <text>{{item.status === 'success' ? '成功' : item.status === 'error' ? '失败' : '处理中'}}</text>
        </view>
      </view>
    </view>

    <!-- 图片识别面板：折叠条（诊断后自动收起，不遮挡回答） -->
    <view class="vision-collapsed" wx:if="{{pendingImage && visionCollapsed}}">
      <image class="vision-collapsed-thumb" src="{{pendingImage.path}}" mode="aspectFill" />
      <text class="vision-collapsed-text">{{visionDesc ? '图片描述：' + visionDesc : '图片已选择（未识别）'}}</text>
      <view class="vision-collapsed-btn" bindtap="expandVisionPanel">
        <text>展开</text>
      </view>
      <view class="vision-collapsed-close" bindtap="dismissPendingImage">
        <text>✕</text>
      </view>
    </view>

    <!-- 图片识别面板：展开视图 -->
    <view class="vision-panel" wx:if="{{pendingImage && !visionCollapsed}}">
      <view class="vision-panel-body">
        <image class="vision-preview" src="{{pendingImage.path}}" mode="aspectFill" />
        <view class="vision-form">
          <block wx:if="{{!visionDesc}}">
            <text class="vision-tip">已选择图片，可补充设备信息后开始识别：</text>
            <input
              class="vision-hint-input"
              placeholder="补充说明（可选），如：主机曲轴箱…"
              placeholder-class="input-placeholder"
              value="{{visionHint}}"
              bindinput="onVisionHintInput"
            />
          </block>
          <block wx:else>
            <text class="vision-tip active">图片描述（可修改后诊断）：</text>
            <textarea
              class="vision-desc-textarea"
              value="{{visionDesc}}"
              bindinput="onVisionDescInput"
              maxlength="600"
              auto-height
            />
          </block>
          <text class="vision-error" wx:if="{{visionError}}">{{visionError}}</text>
          <view class="vision-actions">
            <view class="vision-btn primary" bindtap="{{visionDesc ? 'diagnoseFromVision' : 'runVisionDescribe'}}">
              <text>{{visionDesc ? '🩺 开始诊断' : (visionBusy ? '识别中（约10~30秒）…' : '🔍 开始识别')}}</text>
            </view>
            <view class="vision-btn ghost" wx:if="{{visionDesc}}" bindtap="collapseVisionPanel">
              <text>最小化</text>
            </view>
            <view class="vision-btn ghost" bindtap="dismissPendingImage">
              <text>{{visionDesc ? '清除' : '移除'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 输入框 -->
    <view class="input-bar">
      <view class="attach-btn" bindtap="chooseFile" wx:if="{{!isUploading}}">
        <text class="attach-icon">📎</text>
      </view>
      <view class="attach-btn" wx:if="{{isUploading}}">
        <view class="upload-spinner"></view>
      </view>
      <view class="attach-btn" bindtap="chooseImage" wx:if="{{!visionBusy}}">
        <text class="attach-icon">📷</text>
      </view>
      
      <input 
        class="chat-input"
        type="text"
        placeholder="{{isAnswering ? '正在回答中，请稍候...' : '输入您的问题...'}}"
        placeholder-class="input-placeholder"
        value="{{inputValue}}"
        bindinput="onInputChange"
        confirm-type="send"
        bindconfirm="handleSend"
        disabled="{{isAnswering}}"
      />
      
      <view 
        class="send-btn {{isAnswering && !activeStreamingPaused ? 'pause' : ''}}"
        bindtap="onSendBtnTap"
      >
        <text class="send-icon">{{isAnswering && !activeStreamingPaused ? '⏸' : '▶'}}</text>
      </view>
    </view>
  </view>

  <!-- 新建会话确认弹窗 -->
  <view class="modal-mask" wx:if="{{showNewChatModal}}" bindtap="hideNewChatModal">
    <view class="modal-content" catchtap="preventBubble">
      <text class="modal-title">确认新建会话？</text>
      <text class="modal-desc">当前会话内容将自动保存</text>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="hideNewChatModal">取消</view>
        <view class="modal-btn confirm" bindtap="confirmNewChat">确认</view>
      </view>
    </view>
  </view>
</view>
