/* pages/history/history.wxss */
.history-container {
  min-height: 100vh;
  background: #041527;
  padding: 16px;
  padding-bottom: 80px;
  box-sizing: border-box;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120px;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
  opacity: 0.5;
}

.empty-title {
  font-size: 16px;
  font-weight: 600;
  color: #e2e8f0;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 13px;
  color: #64748b;
  margin-bottom: 24px;
  text-align: center;
}

.empty-btn {
  padding: 12px 32px;
  background: linear-gradient(135deg, #0d9488, #0a2540);
  color: #fff;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
}

.empty-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  padding: 14px 16px;
  transition: all 0.2s;
}

.history-item:active {
  background: rgba(255, 255, 255, 0.06);
  transform: scale(0.99);
}

.history-icon {
  font-size: 20px;
  flex-shrink: 0;
}

.history-info {
  flex: 1;
  min-width: 0;
}

.history-title {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #e2e8f0;
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-meta {
  display: block;
  font-size: 11px;
  color: #64748b;
}

.history-arrow {
  font-size: 18px;
  color: #64748b;
  flex-shrink: 0;
}

/* 底部操作 */
.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  background: rgba(4, 21, 39, 0.95);
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
}

.clear-btn {
  padding: 12px;
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
  border-radius: 10px;
  text-align: center;
  font-size: 14px;
  color: #f87171;
}

.clear-btn:active {
  background: rgba(239, 68, 68, 0.2);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #0a2540;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 24px;
  width: 280px;
  text-align: center;
}

.modal-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8px;
}

.modal-desc {
  display: block;
  font-size: 13px;
  color: #94a3b8;
  margin-bottom: 20px;
}

.modal-actions {
  display: flex;
  gap: 12px;
}

.modal-btn {
  flex: 1;
  padding: 10px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
}

.modal-btn.cancel {
  background: rgba(255, 255, 255, 0.05);
  color: #94a3b8;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.modal-btn.confirm {
  background: rgba(239, 68, 68, 0.2);
  color: #f87171;
  border: 1px solid rgba(239, 68, 68, 0.3);
}
