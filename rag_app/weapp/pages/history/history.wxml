<!--pages/history/history.wxml-->
<view class="history-container">
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{chats.length === 0}}">
    <view class="empty-icon">📋</view>
    <text class="empty-title">暂无历史记录</text>
    <text class="empty-desc">开始一个新的对话，记录将显示在这里</text>
    <view class="empty-btn" bindtap="goToChat">开始对话</view>
  </view>

  <!-- 历史列表 -->
  <view class="history-list" wx:if="{{chats.length > 0}}">
    <view class="history-item" wx:for="{{chats}}" wx:key="id" bindtap="loadChat" data-id="{{item.id}}">
      <view class="history-icon">💬</view>
      <view class="history-info">
        <text class="history-title">{{item.title}}</text>
        <text class="history-meta">{{item.messageCount}} 条消息 · {{item.dateText}}</text>
      </view>
      <view class="history-arrow">›</view>
    </view>
  </view>

  <!-- 清空确认弹窗 -->
  <view class="modal-mask" wx:if="{{showClearModal}}" bindtap="hideClearModal">
    <view class="modal-content" catchtap="preventBubble">
      <text class="modal-title">确认清空所有记录？</text>
      <text class="modal-desc">此操作不可恢复</text>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="hideClearModal">取消</view>
        <view class="modal-btn confirm" bindtap="confirmClear">确认清空</view>
      </view>
    </view>
  </view>
</view>

<!-- 底部清空按钮 -->
<view class="footer-actions" wx:if="{{chats.length > 0}}">
  <view class="clear-btn" bindtap="showClearModal">
    <text>🗑️ 清空所有记录</text>
  </view>
</view>
