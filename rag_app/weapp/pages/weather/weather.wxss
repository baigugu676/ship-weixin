/* pages/weather/weather.wxss */
.weather-container {
  min-height: 100vh;
  background: #041527;
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e2e8f0;
}

.locate-btn {
  font-size: 24rpx;
  color: #38bdf8;
  border: 1rpx solid rgba(56, 189, 248, 0.35);
  background: rgba(56, 189, 248, 0.12);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.locate-btn.busy {
  opacity: 0.6;
}

.refresh-btn {
  font-size: 24rpx;
  color: #94a3b8;
  border: 1rpx solid rgba(148, 163, 184, 0.3);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.location-chips {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.location-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
  margin-right: 14rpx;
  font-size: 26rpx;
  color: #cbd5e1;
}

.location-chip.active {
  border-color: rgba(20, 184, 166, 0.5);
  background: rgba(20, 184, 166, 0.15);
  color: #5eead4;
}

.location-chip.empty {
  color: #64748b;
}

.chip-name {
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-remove {
  font-size: 22rpx;
  color: #64748b;
  padding: 0 4rpx;
}

.chip-remove:active {
  color: #fb7185;
}

.search-bar {
  display: flex;
  gap: 14rpx;
}

.search-input {
  flex: 1;
  background: rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  color: #e2e8f0;
}

.search-placeholder {
  color: #475569;
}

.search-btn {
  background: rgba(20, 184, 166, 0.85);
  color: #fff;
  font-size: 26rpx;
  border-radius: 14rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
}

.search-btn:active {
  background: #14b8a6;
}

.search-results {
  margin-top: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  overflow: hidden;
}

.search-result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.search-result-item:last-child {
  border-bottom: none;
}

.search-result-item:active {
  background: rgba(255, 255, 255, 0.05);
}

.result-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.result-name {
  font-size: 26rpx;
  color: #e2e8f0;
}

.result-detail {
  font-size: 22rpx;
  color: #64748b;
}

.result-add {
  color: #2dd4bf;
  font-size: 28rpx;
  padding: 0 8rpx;
}

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 60rpx 0;
}

.state-text {
  font-size: 26rpx;
  color: #64748b;
}

.error-text {
  font-size: 24rpx;
  color: #fb7185;
  margin: 10rpx 0;
  display: block;
}

.retry-btn {
  font-size: 24rpx;
  color: #38bdf8;
  border: 1rpx solid rgba(56, 189, 248, 0.35);
  border-radius: 999rpx;
  padding: 8rpx 30rpx;
}

.current-card {
  background: linear-gradient(150deg, rgba(13, 148, 136, 0.16), rgba(10, 22, 34, 0.9));
  border: 1rpx solid rgba(45, 212, 191, 0.2);
  border-radius: 22rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
}

.current-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.current-loc {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.current-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.current-sub {
  font-size: 22rpx;
  color: #64748b;
}

.current-main {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.current-temp {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
}

.current-weather {
  font-size: 24rpx;
  color: #94a3b8;
}

.current-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.current-item {
  background: rgba(0, 0, 0, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.current-label {
  font-size: 20rpx;
  color: #64748b;
}

.current-value {
  font-size: 24rpx;
  color: #e2e8f0;
}

.day-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.day-head {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.day-week {
  font-size: 26rpx;
  color: #e2e8f0;
  font-weight: 500;
}

.day-date {
  font-size: 20rpx;
  color: #64748b;
}

.day-weather {
  font-size: 24rpx;
  color: #2dd4bf;
  width: 88rpx;
}

.day-metrics {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 22rpx;
}

.day-metric {
  font-size: 22rpx;
  color: #94a3b8;
}

.data-source {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #475569;
  line-height: 1.6;
}

/* ===================== 历史查询 ===================== */
.hist-picker-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.hist-picker {
  flex-shrink: 0;
}

.hist-picker-inner {
  background: rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #e2e8f0;
}

.hist-query-btn {
  padding: 0 34rpx;
}

.hist-empty {
  display: block;
  padding: 20rpx 0;
}

.hist-list {
  max-height: 60vh;
}
