/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #041527 0%, #0a2540 50%, #0d4a3a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  padding: 40px 24px;
  box-sizing: border-box;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.circle {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(45, 212, 191, 0.1);
}

.circle-1 {
  width: 600px;
  height: 600px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.circle-2 {
  width: 450px;
  height: 450px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.75);
}

.circle-3 {
  width: 300px;
  height: 300px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.5);
}

/* 主要内容 */
.login-content {
  width: 100%;
  max-width: 360px;
  position: relative;
  z-index: 1;
}

/* Logo 区域 */
.logo-section {
  text-align: center;
  margin-bottom: 40px;
}

.logo-box {
  width: 80px;
  height: 80px;
  margin: 0 auto 20px;
  background: linear-gradient(135deg, rgba(45, 212, 191, 0.2), rgba(37, 99, 235, 0.2));
  border: 1px solid rgba(45, 212, 191, 0.4);
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-icon {
  font-size: 36px;
}

.app-title {
  display: block;
  font-size: 22px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2px;
  margin-bottom: 8px;
}

.app-subtitle {
  display: block;
  font-size: 10px;
  color: rgba(45, 212, 191, 0.6);
  letter-spacing: 3px;
  text-transform: uppercase;
}

/* 错误提示 */
.error-box {
  background: rgba(239, 68, 68, 0.15);
  border-left: 3px solid #ef4444;
  border-radius: 6px;
  padding: 12px 16px;
  margin-bottom: 20px;
}

.error-text {
  font-size: 13px;
  color: #fca5a5;
}

/* 表单区域 */
.form-section {
  background: rgba(10, 37, 64, 0.5);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(45, 212, 191, 0.15);
  border-radius: 20px;
  padding: 28px 24px;
}

.input-group {
  margin-bottom: 20px;
}

.input-group:last-of-type {
  margin-bottom: 28px;
}

.input-label {
  display: block;
  font-size: 11px;
  color: rgba(45, 212, 191, 0.8);
  margin-bottom: 8px;
  margin-left: 4px;
  font-weight: 500;
  letter-spacing: 1px;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 0 16px;
  height: 48px;
  transition: all 0.3s;
}

.input-wrap:focus-within {
  border-color: rgba(45, 212, 191, 0.5);
  background: rgba(0, 0, 0, 0.5);
}

.input-icon {
  font-size: 18px;
  margin-right: 12px;
  opacity: 0.7;
}

.input-field {
  flex: 1;
  height: 100%;
  color: #fff;
  font-size: 14px;
  background: transparent;
  border: none;
  outline: none;
}

.placeholder {
  color: rgba(255, 255, 255, 0.3);
  font-size: 14px;
}

.eye-btn {
  padding: 8px;
  margin-left: 4px;
}

.eye-icon {
  font-size: 16px;
  opacity: 0.6;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 48px;
  background: linear-gradient(135deg, #0d9488, #0a2540);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  border-radius: 12px;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4px;
  box-shadow: 0 8px 20px rgba(13, 148, 136, 0.3);
  transition: all 0.3s;
}

.login-btn::after {
  border: none;
}

.login-btn:not(:disabled):active {
  transform: scale(0.98);
  opacity: 0.9;
}

.login-btn:disabled {
  opacity: 0.5;
}

.loading-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
}

.loading-text {
  font-size: 14px;
  letter-spacing: 2px;
}

.loading-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #fff;
  animation: pulse 1.4s ease-in-out infinite;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes pulse {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 底部信息 */
.footer-section {
  margin-top: 32px;
  text-align: center;
}

.footer-text {
  display: block;
  font-size: 10px;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 2px;
  margin-bottom: 12px;
}

.status-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
}

.dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(45, 212, 191, 0.5);
  animation: pulse 2s ease-in-out infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}
