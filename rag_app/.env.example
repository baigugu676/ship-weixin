# ===== 复制本文件为 .env 并填入真实配置（.env 已被 .gitignore 排除，严禁上传）=====

# Neo4j 配置（Docker: scripts/start-neo4j.ps1）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DB=neo4j

# ModelScope 在线模型（https://modelscope.cn → 访问令牌）
RAG_LLM_PROVIDER=modelscope
RAG_LLM_API_KEY=ms-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 聊天模型（上游配置示例；实际可用性取决于上游账号与服务）
# 未配置环境变量时，rag/config.py 的代码默认值仍为 Qwen/Qwen3.5-27B。
RAG_MODELSCOPE_MODEL=Qwen/Qwen3.8-Flash-Next

# 低内存环境（例如容器内存小于 12 GiB）可按需关闭父子检索与本地重排序：
# RAG_USE_PARENT_RETRIEVER=false
# RAG_USE_RERANKER=false
# 关闭父子检索时会跳过父子索引初始化；关闭重排序时不会预热本地重排序模型。

# 图片识别（在线视觉模型；主模型失败后尝试备用模型）
RAG_VISION_PROVIDER=modelscope
RAG_VISION_MODEL=nex-agi/Nex-N2.5-Pro
RAG_VISION_FALLBACK_MODEL=nex-agi/Nex-N2.5-mini
# RAG_VISION_BASE_URL=https://api-inference.modelscope.cn/v1

# 本地生成（Ollama）——取消注释提供者并替换上面的在线提供者配置
# 需预先启动 Ollama、准备模型；客户端保持 use_llm=true。
# RAG_LLM_PROVIDER=ollama
# RAG_LLM_MODEL=qwen2.5:3b
# RAG_OLLAMA_BASE_URL=http://localhost:11434

# 网页/小程序的“离线模式”发送 use_llm=false，使用抽取式回答，不自动切换 Ollama。
# 默认问题分解仍可能调用在线模型。需要避免在线分解时设置 heuristic 或关闭分解：
# RAG_DECOMPOSER_METHOD=heuristic
# RAG_USE_QUERY_DECOMPOSITION=false

# 嵌入模型准备：父子检索默认只读本地模型。首次联网下载可设为 false，
# 或将模型名换成已下载的本地目录；完全离线前需准备好模型与索引。
# RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RAG_EMBEDDING_LOCAL_ONLY=false
# RAG_EMBEDDING_CACHE_DIR=/absolute/path/to/model-cache

# 重排序默认开启，使用本地模型；可按运行环境关闭或配置 DashScope。
# RAG_USE_RERANKER=true
# RAG_RERANKER_PROVIDER=local
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RAG_RERANKER_PROVIDER=dashscope
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# RAG_DASHSCOPE_RERANKER_MODEL=gte-rerank-v2

# KG 流水线 LLM（DashScope / 阿里云百炼，可选）
# 构建子图时使用独立变量，不复用聊天密钥；API_MODEL 默认 qwen3.5-plus。
# API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# API_MODEL=qwen3.5-plus

# 设备业务数据库（与账号、聊天库分开；默认 rag_app/data/equipment.db）
# 建议使用绝对路径；不设置时自动使用默认位置。
# RAG_EQUIPMENT_DB=/absolute/path/to/equipment.db
