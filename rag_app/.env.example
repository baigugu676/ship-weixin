# ===== 复制本文件为 .env 并填入真实配置（.env 已被 .gitignore 排除，严禁上传）=====

# Neo4j 配置（Docker: scripts/start-neo4j.ps1）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DB=neo4j

# ModelScope 在线模型（https://modelscope.cn → 访问令牌）
RAG_LLM_PROVIDER=modelscope
RAG_LLM_API_KEY=ms-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 聊天模型（备选: deepseek-ai/DeepSeek-V4.1-Flash-1017 更快）
RAG_MODELSCOPE_MODEL=Qwen/Qwen3.5-27B

# 图片识别（在线视觉模型，备选: nex-agi/Nex-N2.5-mini 更快）
RAG_VISION_PROVIDER=modelscope
RAG_VISION_MODEL=nex-agi/Nex-N2.5-Pro

# 离线模式（Ollama）——需要时取消注释并注释掉上面的在线配置
# RAG_LLM_PROVIDER=ollama
# RAG_LLM_MODEL=qwen2.5:3b
# RAG_OLLAMA_BASE_URL=http://localhost:11434

# KG 流水线 LLM（DashScope / 阿里云百炼，可选）
# API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
